{
    "//": "secret-guard 安装片段：把下面两个字段合并进 ~/.claude/settings.json（同名字段取并集，不要整体覆盖）",
    "permissions": {
        "deny": [
            "Read(**/.env)",
            "Write(**/.env)",
            "Edit(**/.env)",
            "Read(~/Library/Keychains/**)",
            "Read(~/.thu-agent/**)"
        ]
    },
    "hooks": {
        "PreToolUse": [
            {
                "matcher": "Bash",
                "hooks": [
                    {
                        "type": "command",
                        "command": "node ~/.claude/hooks/secret-guard.mjs"
                    }
                ]
            }
        ]
    }
}
