# 清华 Agent 非敏感配置
# ────────────────────────────────────────────────────────────────
# ⚠️ 凭据（学号/密码/TOTP/卡密）已不再走 .env：运行 `pnpm login-ui`
#    在浏览器向导里完成登录，凭据自动存入 OS 凭据存储
#    （macOS 钥匙串 / Windows 凭据管理器），AI 与明文文件都碰不到。
#    下方 THU_USER_ID / THU_PASSWORD / THU_TOTP_SECRET / THU_CARD_PASSWORD
#    仅作迁移期回退保留——推荐全部留空。
#
# 本文件现在只放非敏感配置（mock 开关、阈值、通知渠道等）。

# 学号（全数字；推荐留空，用 pnpm login-ui 配置）
THU_USER_ID=

# INFO 门户密码（推荐留空！明文存放等效于卡密落盘。用 pnpm login-ui 代替）
THU_PASSWORD=

# 二次认证 TOTP 密钥（可选；配置后 2FA 全自动，无需人工介入）
# 获取方式：登录 id.tsinghua.edu.cn → 账户/安全设置 → 二次认证管理 →
#   绑定"动态口令/验证器"（Google Authenticator、1Password 等均可扫）。
#   绑定页若直接显示"手动输入密钥"文本则复制它；若是二维码，
#   可本地解码二维码图片得到 otpauth://totp/...?secret=XXXX 中的 XXXX
#   （macOS: brew install zbar && zbarimg qr.png）。
#   ⚠️ 不要把二维码上传到在线解码网站——secret 等同于密码。
#   ⚠️ 推荐直接在 pnpm login-ui 向导里粘贴 secret（进凭据存储），
#   或留空：首次登录时在向导里选微信/短信完成 2FA，注册受信设备后
#   之后登录免 2FA；TOTP 只是无人值守场景的保险。
THU_TOTP_SECRET=

# 稳定设备指纹（可选；一般不用填。留空则自动生成 32 位十六进制并持久化到
# data/state.sqlite；只有想多台机器共用同一"受信设备"身份时才手动指定）
# THU_FINGERPRINT=

# 校园卡交易密码（选填，推荐留空进凭据存储。清华一码通：与统一身份认证
# 密码相同，不填时自动复用 password。只有挂失/充值等高风险操作需要）
# THU_CARD_PASSWORD=

# ── 权限管控 ────────────────────────────────────────────────────
# 本进程允许暴露/执行的最高风险级别（默认 write+pay = 全部工具可用）
#   read      只读模式：写工具对客户端彻底不可见（给不受信任的客户端用时设这个）
#   write     允许一般写（选课/订座/日程），隐藏资金类（充值/缴费/挂失）
#   write+pay 全部可用
# 在单个客户端的 server 配置里用 "env" 字段按客户端设置；confirm 执行前
# 还会按当前配置二次校验，旧配置遗留的待确认单也拦得住。
# THU_AGENT_MAX_RISK=write+pay

# ── supervisor 通知与监控（Phase 3）─────────────────────────────
# Bark 推送（iOS App）：装 Bark 后填你的推送基底 URL
# THU_NOTIFY_BARK=https://api.day.app/你的key
# ntfy 推送：订阅的主题 URL
# THU_NOTIFY_NTFY=https://ntfy.sh/你的私有主题名
# 通用 webhook（POST JSON {title, body}）
# THU_NOTIFY_WEBHOOK=
# 校园卡余额提醒阈值（元，默认50）
# THU_CARD_THRESHOLD=50
# 宿舍电费提醒阈值（度，默认30）
# THU_ELE_THRESHOLD=30
# 监控轮询间隔（分钟，默认10）
# THU_MONITOR_INTERVAL_MIN=10

# 1表示开发调试：跳过真实登录，使用内置 mock 账号（8888）
THU_AGENT_MOCK=1

# 数据目录（SQLite 状态库所在，默认 ./data）
# THU_AGENT_DATA_DIR=
